  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@types/node": "24.10.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  }
